{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cinevault",
  "version": "0.1.0",
  "identifier": "com.arina.cinevault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cinevault",
        "width": 800,
        "height": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://image.tmdb.org; media-src 'self' asset: http://asset.localhost blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
